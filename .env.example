# ---------------------------------------------------------------------------
# WhatList environment variables
#
# Copy this file to `.env.local` and fill in your DEV project's values.
# The SAME variable names are used in every environment — only the values
# change (local → dev DB, Vercel prod → prod DB). See ENVIRONMENTS.md.
# ---------------------------------------------------------------------------

# Which environment this instance represents: development | preview | production
# Locally this should be "development". Set it per-scope in Vercel.
NEXT_PUBLIC_APP_ENV=development

# Supabase — from your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# TMDB — from https://www.themoviedb.org/settings/api
# Use the "API Read Access Token" (v4 auth, a long JWT-looking string).
TMDB_ACCESS_TOKEN=your-tmdb-read-access-token

# Base URL of THIS environment (used for auth email redirect links).
# Local dev: http://localhost:3000  |  Production: your Vercel URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
